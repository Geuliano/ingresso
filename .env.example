# Copie este arquivo para .env e ajuste para o seu ambiente.
# NUNCA versionar .env real.

# Banco de dados
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ingresso
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Gere uma chave forte: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# URL base do app (usado para links em e-mails, callbacks, etc.)
APP_URL=http://localhost/ingresso
APP_ENV=production
APP_DEBUG=false

# Timezone padrao
APP_TIMEZONE=America/Porto_Velho

# Codigos de verificacao
VERIFICATION_CODE_LENGTH=6
VERIFICATION_EXPIRES_IN=600
VERIFICATION_COOLDOWN=60
VERIFICATION_MAX_ATTEMPTS=3

# Debug (manter false em producao)
DEBUG_EXPOSE_CODES=false
DEBUG_SEND_EMAILS=false
DEBUG_SEND_WHATSAPP=false

# Integracao n8n para envio de codigos
N8N_ENABLED=false
N8N_WEBHOOK_URL=
N8N_AUTH_TOKEN=
N8N_SIGNING_SECRET=
N8N_TIMEOUT=5

# Painel admin
CLIENTES_API_KEY=

# Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
# Use credenciais de TESTE (TEST-...) em desenvolvimento.
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# Segredo do webhook (configurado no painel do MP em "Suas integrações")
MP_WEBHOOK_SECRET=
